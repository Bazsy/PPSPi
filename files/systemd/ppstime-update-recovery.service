[Unit]
Description=Recover an interrupted PPSPi application update
Before=chrony.service gpsd.service ppstime-healthcheck.service
ConditionPathExistsGlob=/var/lib/ppstime/application-updates/*/transaction.json

[Service]
Type=oneshot
ExecStart=/usr/lib/ppstime/ppstime-update recover
TimeoutStartSec=5min
UMask=0027
StateDirectory=ppstime
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/lib/ppstime /usr/share/ppstime /etc/ppstime /etc/chrony/conf.d /etc/default /etc/apt/apt.conf.d /etc/systemd/system /etc/udev/rules.d /etc/modules-load.d /var/lib/ppstime /boot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
